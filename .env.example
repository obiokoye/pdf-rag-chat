# gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=
# true = scripted AI replies, no key needed (also used automatically when no key is set)
DEMO_MODE=false
# local = MiniLM embeddings on your machine (~80 MB download once) | hash = keyword hashing, no download
# Default: local with a real key, hash in demo mode
# EMBEDDINGS=local
# Where uploaded PDFs and the Chroma index are stored
DATA_DIR=data
